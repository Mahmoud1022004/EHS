# Cloudflare Pages redirect rules.
#
# Repository internals. The site publishes from the repository root, so .git
# and the build sources sit on the CDN beside the pages and are reachable.
# Until the publish directory is narrowed these rules keep them unreadable.
# First match wins, so they stay at the top.
/.git/*  /404.html  301
/.git  /404.html  301
/_build/*  /404.html  301
/_build  /404.html  301
/_to_delete/*  /404.html  301
/README.md  /404.html  301
/.gitignore  /404.html  301


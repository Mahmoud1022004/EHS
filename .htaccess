# EHS — Apache config for GoDaddy cPanel hosting.
# This replaces render.yaml, which only Render reads. Upload it alongside the
# site into public_html. Files here are pre-built: there is no build step.

Options -Indexes
DirectoryIndex index.html

# ---------- Canonical host and scheme ----------
# Every canonical URL, hreflang tag and sitemap entry says https://ehsmeds.com
# with no www, so send everything there once rather than letting both answer.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://ehsmeds.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.ehsmeds\.com$ [NC]
  RewriteRule ^(.*)$ https://ehsmeds.com/$1 [R=301,L]

  # Retired preview pages. The files are gone, but old links should land
  # somewhere useful rather than on a 404.
  RewriteRule ^(gallery|leadership|timeline|loading|location|location-map)-samples\.html$ / [R=301,L]
  RewriteRule ^loading-samples-[0-9]+\.html$ / [R=301,L]
  RewriteRule ^(loader-preview|loading-concepts)\.html$ / [R=301,L]

  # ---------- Extensionless URLs ----------
  # Cloudflare serves /about, not /about.html, and every internal link is built
  # that way. Apache needs telling. These two rules make this host behave the
  # same, so the site is portable between the two.
  #
  # First, send any explicit .html request to the clean URL. Matching on
  # THE_REQUEST (the raw request line) rather than the rewritten path is what
  # keeps this from looping against the internal rewrite below.
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Then serve /about from about.html internally, without a redirect.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ---------- Error page ----------
ErrorDocument 404 /404.html

# ---------- Caching ----------
# Assets carry a ?v= stamp that changes whenever the CSS or JS does, so they
# can be cached hard. Pages must not be, or edits would take a week to appear.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json image/svg+xml
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddCharset UTF-8 .html .css .js .json .xml
</IfModule>
